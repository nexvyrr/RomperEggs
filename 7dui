eventPick = function()
    if not S.Evento then return nil end

    local act = hallowActive()
    local targets = eventTargets()
    local bag = bagAmount()

    if bag >= 450 or (bag > 0 and (#targets == 0 or next(act) == nil)) then
        bankCandy()
        return nil
    end

    if #targets > 0 then
        EvState.Idle = os.clock()
        EvState.Ran = true
        S.EvKind = targets[1].kind
        return targets[1].part
    end

    local tActive = titanicActive()
    local sid = Workspace:GetAttribute("TitanicSpawnId")
    if sid ~= EvState.TitanicId then
        EvState.TitanicId = sid
        EvState.TitanicDone = false
        EvState.TIdle = nil
    end

    if tActive and not EvState.TitanicDone then
        local tz = tonumber(Workspace:GetAttribute("TitanicZoneIndex"))
        if not tz then
            EvState.TitanicDone = true
        elseif tz > safeMaxZone() then
            EvState.TitanicDone = true
            notify("n_titanic", "triangle-alert")
        else
            local pos = zoneCenter(tz)
            local hrp = getHRP()
            if pos and hrp and flatDist(hrp.Position, pos) > 120 then
                S.Estado = "Evento: corriendo a la zona " .. tz
                if os.clock() - EvState.Stream > 3 then
                    EvState.Stream = os.clock()
                    pcall(function() LP:RequestStreamAroundAsync(pos, 3) end)
                end
                moveTo(CFrame.new(groundPos(pos)), abortFarm)
                EvState.TIdle = nil
                return nil
            end
            EvState.TIdle = EvState.TIdle or os.clock()
            if os.clock() - EvState.TIdle > 14 then
                EvState.TitanicDone = true
            end
        end
    end

    local anyActive = next(act) ~= nil or (tActive and not EvState.TitanicDone)
    if anyActive then
        S.Estado = "Evento: esperando objetivos..."
        EvState.Idle = os.clock()
        return nil
    end

    S.Estado = "Evento: buscando..."
    if os.clock() - EvState.Idle > 6 then
        eventFinish(EvState.Ran and "n_evend" or "n_noev")
    end
    return nil
end

local function farmCycle()
    if isDead() or not getHRP() then
        S.Estado = "Esperando personaje"
        task.wait(0.5)
        return
    end

    local c = getChar()
    if LP:GetAttribute("Jailed") == true then
        S.Estado = "Encarcelado, esperando"
        task.wait(0.5)
        return
    end
    if c and c:GetAttribute("Ragdolled") and not S.AntiGolpe then
        task.wait(0.3)
        return
    end

    if holding() then
        S.Estado = "Golpeado: quedandome en el lugar..."
        task.wait(0.1)
        return
    end

    if inForbiddenZone() and not S.Carried then
        escapeToBase()
        return
    end

    if carrying() then
        S.Busy = true
        Sub.go()
        S.Busy = false
        return
    end

    if S.Carried then
        S.Busy = true
        S.Estado = "Recuperando el animal..."
        local pickup
        local t0 = os.clock()
        while Alive and S.Run and not isDead() and not holding() and os.clock() - t0 < 6 do
            local h = getHRP()
            pickup = h and findPickup(nil, h.Position, true)
            if pickup then break end
            task.wait(0.15)
        end
        if pickup then
            if grab(pickup) then
                S.RecTry = 0
                Sub.go()
            else
                S.RecTry = S.RecTry + 1
                if S.RecTry >= 4 then S.Carried = false; S.RecTry = 0 end
            end
        elseif not holding() then
            S.Carried = false
            S.RecTry = 0
        end
        S.Busy = false
        return
    end

    if dodge() then return end

    local egg
    if S.Evento then
        egg = eventPick()
        S.Target = egg
        if not egg then
            task.wait(0.3)
            return
        end
    else
        egg = desiredEgg()
        S.Target = egg
        if not egg then
            S.Estado = "No hay huevos en zonas seguras"
            task.wait(0.6)
            return
        end
    end
    if not equipPickaxe() then
        notify("n_pick", "triangle-alert")
        S.Estado = "No tienes el pico"
        task.wait(1)
        return
    end

    setHighlight(egg)
    S.Estado = "Yendo al huevo..."
    if not moveTo(standCF(egg), abortFarm) then return end

    S.Estado = "Rompiendo huevo..."
    local result = breakEgg(egg)
    if result == "switch" or not S.Run then return end

    if S.Evento and (S.EvKind == "door" or S.EvKind == "pile") then
        local tw = os.clock()
        local lim = S.EvKind == "door" and 4 or 2.2
        while Alive and S.Run and os.clock() - tw < lim do
            task.wait(0.1)
        end
        return
    end

    local t0 = os.clock()
    while Alive and S.Run and os.clock() - t0 < 3 do
        if egg:GetAttribute("Hatching") or egg:GetAttribute("HatchId") ~= nil or not egg.Parent then break end
        task.wait(0.05)
    end
    local hatchId = egg:GetAttribute("HatchId")
    local epos = egg.Position
    if egg:GetAttribute("NoPickup") then return end

    S.Busy = true
    S.Estado = "Esperando que salga el animal..."
    local pickup
    t0 = os.clock()
    while Alive and S.Run and not isDead() and os.clock() - t0 < ((S.Evento and S.EvKind == "phantom") and 6 or CFG.EsperaPickup) do
        pickup = findPickup(hatchId, epos, os.clock() - t0 > 10)
        if pickup then break end
        dodge()
        task.wait(0.1)
    end

    if not pickup then
        S.Estado = "No aparecio el animal (se salta este huevo)"
        S.Busy = false
        return
    end

    if grab(pickup) then
        S.Carried = true
        S.RecTry = 0
        Sub.go()
    else
        ST.Fallos = ST.Fallos + 1
        S.Estado = "No pude agarrar el animal"
        notify("n_grab", "triangle-alert")
    end
    S.Busy = false
end

