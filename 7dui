local CashCache, RarityCache, RosterCache, SizeCache, EggRarCache = {}, {}, {}, {}, {}

local function animalCash(name, entry)
    local c = CashCache[name]
    if c then return c end
    local v
    if EggRewardsMod and EggRewardsMod.CashPerSecond then
        local ok, r = pcall(EggRewardsMod.CashPerSecond, name)
        if ok and type(r) == "number" then v = r end
    end
    if not v and entry and type(entry.Cash) == "number" then v = entry.Cash end
    v = v or 0
    CashCache[name] = v
    return v
end

local function animalRarity(name, entry)
    local r = RarityCache[name]
    if r then return r end
    if EggRewardsMod and EggRewardsMod.RarityOf then
        local ok, x = pcall(EggRewardsMod.RarityOf, name)
        if ok and type(x) == "string" then r = x end
    end
    r = r or (entry and entry.Rarity) or "?"
    RarityCache[name] = r
    return r
end

local function rosterOf(eggType)
    local cached = RosterCache[eggType]
    if cached then return cached end
    local list = {}
    local cfg = EggTypeCfg and EggTypeCfg.Get and EggTypeCfg.Get(eggType)
    if cfg and type(cfg.HatchPool) == "table" and #cfg.HatchPool > 0 then
        for _, n in ipairs(cfg.HatchPool) do
            local w = (cfg.HatchWeights and cfg.HatchWeights[n]) or 1
            list[#list + 1] = { name = n, chance = w, cash = animalCash(n), rarity = animalRarity(n) }
        end
    elseif EggRewardsMod and EggRewardsMod.Pool then
        local ok, z = pcall(function()
            return EggRewardsMod.RosterZoneOf(EggRewardsMod.ZoneOfEggType(eggType))
        end)
        if ok and z then
            for _, e in pairs(EggRewardsMod.Pool) do
                if type(e) == "table" and e.Zone == z and e.Name then
                    list[#list + 1] = {
                        name   = e.Name,
                        chance = tonumber(e.Chance) or tonumber(e.Weight) or 1,
                        cash   = animalCash(e.Name, e),
                        rarity = animalRarity(e.Name, e),
                    }
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.cash < b.cash end)
    if #list > 0 then RosterCache[eggType] = list end
    return list
end

local function sizeFactor(refName, refCash, size)
    local key = refName .. "|" .. tostring(size)
    local f = SizeCache[key]
    if f then return f end
    f = size
    if refCash > 0 and EggRewardsMod and EggRewardsMod.PlacedCashPerSecond then
        local ok, r = pcall(EggRewardsMod.PlacedCashPerSecond, refName, size, nil, nil, nil)
        if ok and type(r) == "number" and r > 0 then f = r / refCash end
    end
    SizeCache[key] = f
    return f
end

local function eggRarityOf(eggType)
    local r = EggRarCache[eggType]
    if r then return r end
    if EggRarityMod and EggRarityMod.ForEggType then
        local ok, x = pcall(EggRarityMod.ForEggType, eggType)
        if ok and type(x) == "string" then r = x end
    end
    if not r and EggTypeCfg and EggTypeCfg.Get then
        local cfg = EggTypeCfg.Get(eggType)
        if cfg and type(cfg.Rarity) == "string" then r = cfg.Rarity end
    end
    if r then EggRarCache[eggType] = r end
    return r
end

local function eggValue(p)
    local eggType = tostring(p:GetAttribute("EggType") or "")
    local size = tonumber(p:GetAttribute("HatchSizeMult")) or 1
    local luck = tonumber(p:GetAttribute("HatchLuck")) or tonumber(p:GetAttribute("Luck")) or 1
    local eggRar = eggRarityOf(eggType)
    local fixed = p:GetAttribute("HatchAnimal")

    if type(fixed) == "string" and fixed ~= "" then
        local base = animalCash(fixed)
        local v = base * sizeFactor(fixed, base, size)
        local rar = animalRarity(fixed)
        return { exp = v, best = v, bestName = fixed, bestRarity = rar, eggRarity = eggRar or rar }
    end

    local list = rosterOf(eggType)
    local n = #list
    if n == 0 then
        return { exp = 0, best = 0, bestName = "?", bestRarity = "?", eggRarity = eggRar or "?" }
    end

    local top = list[n]
    local f = sizeFactor(top.name, top.cash, size)
    local sw, sc = 0, 0
    for i, a in ipairs(list) do
        local t = n > 1 and (i - 1) / (n - 1) or 0
        local w = a.chance * (1 + (luck - 1) * t)
        sw = sw + w
        sc = sc + w * a.cash
    end
    return {
        exp        = sw > 0 and (sc / sw) * f or 0,
        best       = top.cash * f,
        bestName   = top.name,
        bestRarity = top.rarity,
        eggRarity  = eggRar or top.rarity,
    }
end

local function eggInfo(p, pos)
    local d = 0
    if pos then d = (p.Position - pos).Magnitude end
    local hp = tonumber(p:GetAttribute("Health")) or 0
    local eta = 0
    if S.Dps > 0 then eta = hp / S.Dps end
    local v = eggValue(p)
    return {
        part       = p,
        name       = tostring(p:GetAttribute("EggType") or "Egg"),
        zone       = eggZone(p),
        bracket    = tostring(p:GetAttribute("WeightBracket") or ""),
        brank      = BRACKET[tostring(p:GetAttribute("WeightBracket") or "")] or 0,
        size       = tonumber(p:GetAttribute("SizeMult")) or 1,
        luck       = tonumber(p:GetAttribute("Luck")) or 1,
        kg         = tonumber(p:GetAttribute("WeightKg")) or 0,
        hp         = hp,
        eta        = eta,
        dist       = d,
        value      = v.exp,
        best       = v.best,
        bestName   = v.bestName,
        bestRarity = v.bestRarity,
        eggRarity  = v.eggRarity,
    }
end

local function better(a, b)
    if a.value ~= b.value then return a.value > b.value end
    if a.zone ~= b.zone then return a.zone > b.zone end
    if a.brank ~= b.brank then return a.brank > b.brank end
    if a.size ~= b.size then return a.size > b.size end
    if a.luck ~= b.luck then return a.luck > b.luck end
    if a.kg ~= b.kg then return a.kg > b.kg end
    return a.dist < b.dist
end

local function scanEggs(ignoreCap)
    local hrp = getHRP()
    local pos = hrp and hrp.Position
    local cap = ignoreCap and 99 or allowedMaxZone()
    local list = {}
    for _, p in ipairs(CollectionService:GetTagged("BreakableEgg")) do
        if p:IsA("BasePart") and p:GetAttribute("EggType") and eggLive(p) and (Black[p] or 0) < os.clock() then
            local info = eggInfo(p, pos)
            if info.zone >= 1 and info.zone <= cap and not guardActiveNear(p.Position, 80) then
                list[#list + 1] = info
            end
        end
    end
    table.sort(list, better)
    return list
end

local function eggLabel(info, rank)
    return string.format("%d. %s | Z%d | $%s/s | %s", rank, info.name, info.zone, fmt(info.value), tostring(info.eggRarity))
end

local function selectAuto()
    if EggDropdown then
