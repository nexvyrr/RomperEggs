        end
        if inst:IsA("ImageLabel") and inst.Image ~= "" then return same(inst.Image) end
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("Sky") then
                local f = fromSky(d)
                if f then return f end
            end
        end
        for _, d in ipairs(inst:GetDescendants()) do
            if (d:IsA("Decal") or d:IsA("Texture")) and d.Texture ~= "" then return same(d.Texture) end
            if d:IsA("ImageLabel") and d.Image ~= "" then return same(d.Image) end
        end
        return nil
    end

    function Look.resolve(id)
        if Look.Cache[id] then return Look.Cache[id] end
        local faces
        pcall(function()
            local objs = game:GetObjects("rbxassetid://" .. id)
            if objs then
                for _, o in ipairs(objs) do
                    faces = faces or scan(o)
                    pcall(function() o:Destroy() end)
                end
            end
        end)
        if not faces then
            local n = tonumber(id)
            local cands = {
                "rbxassetid://" .. id,
                "rbxassetid://" .. (n - 1),
                "rbxassetid://" .. (n + 1),
                "http://www.roblox.com/asset/?id=" .. id,
                "http://www.roblox.com/asset/?id=" .. (n - 1),
            }
            for _, url in ipairs(cands) do
                if loads(url) then
                    faces = same(url)
                    break
                end
            end
        end
        if faces then Look.Cache[id] = faces end
        return faces
    end

    function Look.set(mode, sky)
        restore()
        Look.Mode, Look.Sky = mode, sky
        Look.Tok = Look.Tok + 1
        local tok = Look.Tok
        if not mode and not sky then return end

        local P = mode and PRESET[mode] or nil
        local skyId
        if sky then
            for _, s in ipairs(Look.Skies) do
                if s.key == sky then skyId = s.id end
            end
        end
        if not skyId and mode then skyId = PINK_SKY end

        local faces = skyId and Look.resolve(skyId) or nil
        if tok ~= Look.Tok then return end
        if skyId and not faces then
            notify("n_sky", "triangle-alert")
        end

        if P then
            Look.Orig = {}
            for _, p in ipairs(LIGHT_PROPS) do
                pcall(function() Look.Orig[p] = Lighting[p] end)
            end
        end

        for _, ch in ipairs(Lighting:GetChildren()) do
            if string.sub(ch.Name, 1, 14) ~= "NEXVYRHUB_LOOK" then
                if ch:IsA("Atmosphere") and (P or faces) then
                    hideParent(ch)
                elseif ch:IsA("Sky") and faces then
                    hideParent(ch)
                elseif P and (ch:IsA("ColorCorrectionEffect") or ch:IsA("BloomEffect") or ch:IsA("SunRaysEffect")) then
                    hideProps(ch, { Enabled = ch.Enabled }, { Enabled = false })
                end
            end
        end

        if faces then
            local s = make("Sky", "NEXVYRHUB_LOOK_SKY", Lighting)
            s.SkyboxBk, s.SkyboxDn, s.SkyboxFt = faces.Bk, faces.Dn, faces.Ft
            s.SkyboxLf, s.SkyboxRt, s.SkyboxUp = faces.Lf, faces.Rt, faces.Up
            s.StarCount = 0
            s.CelestialBodiesShown = false
        end

        if not P then return end

        for _, p in ipairs(LIGHT_PROPS) do
            if P[p] ~= nil then pcall(function() Lighting[p] = P[p] end) end
        end

        local atm = make("Atmosphere", "NEXVYRHUB_LOOK_ATM", Lighting)
        atm.Color, atm.Decay, atm.Density, atm.Offset, atm.Glare, atm.Haze = P.AtmColor, P.AtmDecay, P.AtmDensity, P.AtmOffset, P.AtmGlare, P.AtmHaze

        local cc = make("ColorCorrectionEffect", "NEXVYRHUB_LOOK_CC", Lighting)
        cc.TintColor, cc.Saturation, cc.Contrast, cc.Brightness = P.Tint, P.Sat, P.Contrast, P.CcBright

        local bl = make("BloomEffect", "NEXVYRHUB_LOOK_BLOOM", Lighting)
        bl.Intensity, bl.Size, bl.Threshold = P.BloomI, P.BloomS, P.BloomT

        local sr = make("SunRaysEffect", "NEXVYRHUB_LOOK_RAYS", Lighting)
        sr.Intensity, sr.Spread = P.RaysI, P.RaysS

        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            for _, ch in ipairs(terrain:GetChildren()) do
                if ch:IsA("Clouds") and string.sub(ch.Name, 1, 14) ~= "NEXVYRHUB_LOOK" then
                    hideProps(ch, { Enabled = ch.Enabled }, { Enabled = false })
                end
            end
            local cl = make("Clouds", "NEXVYRHUB_LOOK_CLOUDS", terrain)
            cl.Cover, cl.Density, cl.Color, cl.Enabled = P.CloudCover, P.CloudDensity, P.CloudColor, true
        end
    end
end
