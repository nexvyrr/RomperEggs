function UI.labels()
    local L = {}
    L.autoZona = tr("zone_auto")
    L.zonas = { L.autoZona }
    L.zonaKey = {}
    for i, z in ipairs(ZONAS) do
        local lb = tr("zone_fmt", i, fmt(z.Poder))
        L.zonas[#L.zonas + 1] = lb
        L.zonaKey[lb] = i
    end
    L.zonaCur = L.autoZona
    if S.ZonaMax and ZONAS[S.ZonaMax] then
        L.zonaCur = tr("zone_fmt", S.ZonaMax, fmt(ZONAS[S.ZonaMax].Poder))
    end

    L.themes = { tr("theme_violet"), tr("theme_pink") }
    L.themeKey = { [L.themes[1]] = "Violeta", [L.themes[2]] = "RosaOscuro" }
    L.themeCur = UI.Theme == "RosaOscuro" and L.themes[2] or L.themes[1]

    L.skies = { tr("sky_default") }
    L.skyKey = {}
    local cur = L.skies[1]
    for _, s in ipairs(UI.Look.Skies) do
        local lb = tr("sky_" .. s.key)
        L.skies[#L.skies + 1] = lb
        L.skyKey[lb] = s.key
        if UI.Look.Sky == s.key then cur = lb end
    end
    L.skyDefault = L.skies[1]
    L.skyCur = cur
    UI.L = L
    return L
end

function UI.relabel(old, new)
    if old == nil or new == nil or old == new then return end
    local root = (gethui and gethui()) or CoreGui
    pcall(function()
        for _, d in ipairs(root:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text == old then
                d.Text = new
            end
        end
    end)
end

function UI.applyLang(old)
    UI.Building = true
    for _, r in ipairs(UI.Reg) do
        local okT = false
        if r.t then
            okT = pcall(function() r.obj:SetTitle(tr(r.t)) end)
        end
        if r.d then
            pcall(function() r.obj:SetDesc(tr(r.d)) end)
        end
        if r.t and r.scan and not okT then
            UI.relabel(I18N[old] and I18N[old][r.t], tr(r.t))
        end
    end

    local L = UI.labels()
    local function refresh(dd, values, cur)
        if not dd then return end
        pcall(function() dd:Refresh(values) end)
        pcall(function() dd:Select(cur) end)
    end
    refresh(UI.Dd.zona, L.zonas, L.zonaCur)
    refresh(UI.Dd.theme, L.themes, L.themeCur)
    refresh(UI.Dd.sky, L.skies, L.skyCur)

    lastSpyKey = ""
