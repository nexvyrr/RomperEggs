local function hallowActive()
    local now = Workspace:GetServerTimeNow()
    local raw = Workspace:GetAttribute("HalloweenScheduleState")
    if raw ~= HallowCache.Raw then
        HallowCache.Raw = raw
        HallowCache.Data = {}
        if type(raw) == "string" and raw ~= "" then
            local ok, st = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok and type(st) == "table" and type(st.Active) == "table" then
                for _, a in ipairs(st.Active) do
                    if type(a) == "table" and a.Key and tonumber(a.EndsAt) then
                        HallowCache.Data[a.Key] = tonumber(a.EndsAt)
                    end
                end
            end
        end
    end
    local act = {}
    for k, e in pairs(HallowCache.Data) do
        if e > now then act[k] = e end
    end
    if Workspace:GetAttribute("BloodMoonActive") == true and not act.BloodMoon then
        act.BloodMoon = now + 30
    end
    return act
end

