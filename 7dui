local function applyEventLock()
    if not EventToggle then return end
    if S.EventoLock and S.Evento then
        pcall(function() EventToggle:Lock() end)
    else
        pcall(function() EventToggle:Unlock() end)
    end
end

local function unload()
    if not Alive then return end
    Alive = false
    S.Farm, S.Evento, S.Run, S.AntiGolpe, S.IrHuevo, S.Espiar, S.AntiAfk = false, false, false, false, false, false, false
    S.Gen = S.Gen + 1
    applyFlingBlock(false)
    patchRagdoll(false)
    lockStates(false)
    pcall(Move.release, true)
    pcall(UI.Look.set, nil, nil)
    pcall(rendSet, false)
    if FX.On then
        FX.On = false
        FX.Token = FX.Token + 1
        for _, c in ipairs(FX.Conns) do pcall(function() c:Disconnect() end) end
        FX.Conns = {}
        fxEnvironment(false)
        task.spawn(fxRestoreAll)
    end
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    if HL then pcall(function() HL:Destroy() end) end
    if SpyBill then pcall(function() SpyBill:Destroy() end) end
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    if Window then pcall(function() Window:Destroy() end) end
    genv.NEXVYRHUB_UNLOAD = nil
end

