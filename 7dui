local function equipPickaxe()
    if pickaxeInHand() then return true end
    local hum = getHum()
    local bp = LP:FindFirstChildOfClass("Backpack")
    local tool = bp and bp:FindFirstChild("Pickaxe")
    if hum and tool and tool:IsA("Tool") then
        pcall(function() hum:EquipTool(tool) end)
        local t0 = os.clock()
        while os.clock() - t0 < 1 and not pickaxeInHand() do
            task.wait(0.05)
        end
    end
    return pickaxeInHand()
end

local function swingAt(egg)
    local req = RS:FindFirstChild("EggHitRequest")
    if not req then return end
    local swing = RS:FindFirstChild("MasteryPickaxeSwing")
    if swing then swing:FireServer() end
    task.delay(CFG.RetrasoGolpe, function()
        if not Alive or not S.Farm then return end
        if not eggLive(egg) or not pickaxeInHand() then return end
        S.HitId = S.HitId + 1
        req:FireServer(egg, S.HitId)
    end)
end

local function breakEgg(egg)
    local last = 0
    local winHp = tonumber(egg:GetAttribute("Health")) or 0
    local winT = os.clock()
    local lastCheck = os.clock()
    local startT = os.clock()
    local lastHp = tonumber(egg:GetAttribute("Health"))
    local lastDrop = os.clock()

    while Alive and S.Farm and not isDead() do
        if dodge() then return "switch" end
        if not egg.Parent then return "gone" end
        if not eggLive(egg) then return "dead" end
        local hp = egg:GetAttribute("Health")
        if type(hp) == "number" and hp <= 0 then return "dead" end
        if S.Selected and S.Selected ~= egg and eggLive(S.Selected) then return "switch" end

        local now = os.clock()

        if type(hp) == "number" and (lastHp == nil or hp < lastHp) then
            lastHp, lastDrop = hp, now
        end
        if now - lastDrop > CFG.SinDano or now - startT > CFG.MaxPorHuevo then
            Black[egg] = now + CFG.VetoHuevo
            ST.Vetados = ST.Vetados + 1
            if S.Selected == egg then
                S.Selected = nil
                selectAuto()
            end
            notify("Huevo sin progreso: lo salto un rato", "triangle-alert")
            return "switch"
        end

        if type(hp) == "number" and now - winT >= 1.5 then
            if hp < winHp then
                local sample = (winHp - hp) / (now - winT)
                if S.Dps <= 0 then S.Dps = sample else S.Dps = S.Dps * 0.7 + sample * 0.3 end
            end
            winHp, winT = hp, now
        end

        if not S.Selected and S.Dps > 0 and now - lastCheck >= 2 and type(hp) == "number" then
            lastCheck = now
            if hp / S.Dps > S.MaxEta then
                local alt = desiredEgg()
                if alt and alt ~= egg then
                    local altHp = tonumber(alt:GetAttribute("Health")) or 0
                    if altHp < hp then return "switch" end
                end
            end
        end

        if eggZone(egg) > allowedMaxZone() then return "switch" end

        local hrp = getHRP()
        if hrp and surfDist(egg, hrp.Position) > 6.5 then
            if not moveTo(standCF(egg), abortFarm) then return "gone" end
            lastDrop = os.clock()
        end
        if not pickaxeInHand() then equipPickaxe() end

        if now - last >= S.Cooldown then
            last = now
            swingAt(egg)
        end
        task.wait()
    end
    return "gone"
end

