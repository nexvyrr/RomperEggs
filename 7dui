end

local function zoneAt(pos)
    local build = Workspace:FindFirstChild("Build")
    local folder = build and build:FindFirstChild("ZoneHitboxes")
    if not folder then return nil end
    for i = 1, #ZONAS do
        local p = folder:FindFirstChild(tostring(i))
        if p and p:IsA("BasePart") then
            local l = p.CFrame:PointToObjectSpace(pos)
            local h = p.Size * 0.5
            if math.abs(l.X) <= h.X and math.abs(l.Z) <= h.Z then
                return i
            end
        end
    end
    local safe = folder:FindFirstChild("SafeZone")
    if safe and safe:IsA("BasePart") then
        local l = safe.CFrame:PointToObjectSpace(pos)
        local h = safe.Size * 0.5
        if math.abs(l.X) <= h.X and math.abs(l.Z) <= h.Z then
            return 0
        end
    end
    return nil
end

local function safeMaxZone()
    local p = playerPower()
    local best = 0
    for i, z in ipairs(ZONAS) do
        if p >= z.Poder * S.Margen then
            best = i
        else
            break
        end
    end
    return best
end

local function allowedMaxZone()
    local m = safeMaxZone()
    if S.ZonaMax and S.ZonaMax < m then m = S.ZonaMax end
    return m
end

local function eggZone(p)
    local z = tonumber(p:GetAttribute("ZoneIndex"))
    if z then return z end
    local a = p
    while a and a ~= Workspace do
        local n = tonumber(string.match(a.Name, "^Zone(%d+)$"))
        if n then return n end
        a = a.Parent
    end
    local byPos = zoneAt(p.Position)
    return byPos or 0
end

local GuardCache, GuardAt = {}, 0

local function guards()
    local now = os.clock()
    if now - GuardAt < 1 then return GuardCache end
    GuardAt = now
    local list = {}
    local build = Workspace:FindFirstChild("Build")
    local zb = build and build:FindFirstChild("ZoneBuilds")
    if zb then
        for _, z in ipairs(zb:GetChildren()) do
            for _, m in ipairs(z:GetChildren()) do
                if m:IsA("Model") and m:GetAttribute("ChaseState") ~= nil then
                    list[#list + 1] = m
                end
            end
        end
    end
    GuardCache = list
    return list
end

local function flatDist(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function carryingNow()
    if LP:GetAttribute("Carrying") ~= nil then return true end
    local n = LP:GetAttribute("CarryCount")
    return type(n) == "number" and n > 0
end

local function guardActive(g)
    local st = g:GetAttribute("ChaseState")
    return st == "WindUp" or st == "Chasing"
end

local function guardThreat()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestD
    for _, g in ipairs(guards()) do
        if g.Parent and guardActive(g) then
            local tid = g:GetAttribute("TargetUserId")
            local d = flatDist(g:GetPivot().Position, hrp.Position)
            local mine = (tid == LP.UserId) or (tid == nil and d < 45)
            if mine and d < 110 and (not bestD or d < bestD) then
                best, bestD = g, d
            end
        end
    end
    return best, bestD
end

local function guardActiveNear(pos, radius)
    for _, g in ipairs(guards()) do
        if g.Parent and guardActive(g) then
            if flatDist(g:GetPivot().Position, pos) < radius then return true end
        end
    end
    return false
end

local BRACKET = { TITANIC = 3, HUGE = 2, BIG = 1 }

local function eggLive(p)
    return p ~= nil
        and p.Parent ~= nil
        and not p:GetAttribute("Broken")
        and not p:GetAttribute("Hatching")
        and not p:GetAttribute("Despawning")
end

local function eggInfo(p, pos)
    local d = 0
    if pos then d = (p.Position - pos).Magnitude end
    local hp = tonumber(p:GetAttribute("Health")) or 0
    local eta = 0
    if S.Dps > 0 then eta = hp / S.Dps end
    return {
        part    = p,
        name    = tostring(p:GetAttribute("EggType") or "Egg"),
        zone    = eggZone(p),
        bracket = tostring(p:GetAttribute("WeightBracket") or ""),
        brank   = BRACKET[tostring(p:GetAttribute("WeightBracket") or "")] or 0,
        size    = tonumber(p:GetAttribute("SizeMult")) or 1,
        luck    = tonumber(p:GetAttribute("Luck")) or 1,
        kg      = tonumber(p:GetAttribute("WeightKg")) or 0,
        hp      = hp,
        eta     = eta,
        dist    = d,
    }
end

local function better(a, b)
    if a.zone ~= b.zone then return a.zone > b.zone end
    if a.brank ~= b.brank then return a.brank > b.brank end
    if a.size ~= b.size then return a.size > b.size end
    if a.luck ~= b.luck then return a.luck > b.luck end
    if a.kg ~= b.kg then return a.kg > b.kg end
    return a.dist < b.dist
end

local function scanEggs()
    local hrp = getHRP()
    local pos = hrp and hrp.Position
    local cap = allowedMaxZone()
    local list = {}
    for _, p in ipairs(CollectionService:GetTagged("BreakableEgg")) do
        if p:IsA("BasePart") and p:GetAttribute("EggType") and eggLive(p) and (Black[p] or 0) < os.clock() then
            local info = eggInfo(p, pos)
            if info.zone >= 1 and info.zone <= cap and not guardActiveNear(p.Position, 80) then
                list[#list + 1] = info
            end
        end
    end
    table.sort(list, better)
    return list
end

local function eggLabel(info, rank)
    local tag = ""
    if info.bracket ~= "" then tag = " " .. info.bracket end
    local eta = ""
    if S.Dps > 0 then eta = string.format(" | ~%ds", math.min(math.floor(info.eta), 9999)) end
    return string.format("%d. %s | Z%d%s | x%.2f | %skg%s", rank, info.name, info.zone, tag, info.size, fmt(info.kg), eta)
end

