local Rend = {
    On     = false,
    Token  = 0,
    Conns  = {},
    Hidden = setmetatable({}, { __mode = "k" }),
    Guis   = setmetatable({}, { __mode = "k" }),
    Anims  = setmetatable({}, { __mode = "k" }),
    Hums   = setmetatable({}, { __mode = "k" }),
    Tech   = nil,
}

local function topModel(inst)
    local a = inst
    while a and a.Parent and a.Parent ~= Workspace do a = a.Parent end
    return a
end

local function isOthers(inst)
    local top = topModel(inst)
    if not top or top.Parent ~= Workspace then return false end
    if top.Name == "Plots" then
        local a = inst
        while a and a.Parent ~= top do a = a.Parent end
        return a ~= nil and a:GetAttribute("OwnerUserId") ~= LP.UserId
    end
    local pl = Players:GetPlayerFromCharacter(top)
    return pl ~= nil and pl ~= LP
end

local function rendApply(inst)
    if not Rend.On then return end
    if inst:IsA("BasePart") then
        if isOthers(inst) then
            if inst.LocalTransparencyModifier ~= 1 then inst.LocalTransparencyModifier = 1 end
            Rend.Hidden[inst] = true
        end
    elseif inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") then
        if string.sub(inst.Name, 1, 9) ~= "NEXVYRHUB" and inst.Enabled then
            Rend.Guis[inst] = true
            inst.Enabled = false
        end
    elseif inst:IsA("Animator") then
        if isOthers(inst) then
            Rend.Anims[inst] = true
            for _, tr in ipairs(inst:GetPlayingAnimationTracks()) do
                pcall(tr.Stop, tr, 0)
            end
        end
    elseif inst:IsA("Humanoid") then
        if isOthers(inst) and Rend.Hums[inst] == nil then
            Rend.Hums[inst] = inst.DisplayDistanceType
            inst.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
    end
end

local function rendHook(inst)
    pcall(rendApply, inst)
end

local function rendSweep(token)
    local t = os.clock()
    local list = Workspace:GetDescendants()
    for i = 1, #list do
        if Rend.Token ~= token or not Rend.On or not Alive then return end
        pcall(rendApply, list[i])
        if os.clock() - t > 0.004 then
            task.wait()
            t = os.clock()
        end
    end
end

local function rendTech(on)
    if on then
        if Rend.Tech == nil and gethiddenproperty and sethiddenproperty then
            local ok, cur = pcall(gethiddenproperty, Lighting, "Technology")
            if ok and cur ~= nil then
                Rend.Tech = cur
                pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Compatibility)
            end
        end
    elseif Rend.Tech ~= nil then
        pcall(sethiddenproperty, Lighting, "Technology", Rend.Tech)
        Rend.Tech = nil
    end
end

local function rendRestore()
    for p in pairs(Rend.Hidden) do
        if p.Parent then pcall(function() p.LocalTransparencyModifier = 0 end) end
    end
    Rend.Hidden = setmetatable({}, { __mode = "k" })
    for g in pairs(Rend.Guis) do
        if g.Parent then pcall(function() g.Enabled = true end) end
    end
    Rend.Guis = setmetatable({}, { __mode = "k" })
    for h, v in pairs(Rend.Hums) do
        if h.Parent then pcall(function() h.DisplayDistanceType = v end) end
    end
    Rend.Hums = setmetatable({}, { __mode = "k" })
    Rend.Anims = setmetatable({}, { __mode = "k" })
end

local function rendSet(on)
    on = on and true or false
    if on == Rend.On then return end
    Rend.On = on
    Rend.Token = Rend.Token + 1
    local token = Rend.Token
    S.Rend = on
    FX.Deep = on

    if on then
        local was = FX.On
        fxRefresh()
        if was then
            FX.Token = FX.Token + 1
            task.spawn(fxSweep, FX.Token)
        end
        rendTech(true)
        Rend.Conns[#Rend.Conns + 1] = Workspace.DescendantAdded:Connect(rendHook)
        task.spawn(rendSweep, token)
        task.spawn(function()
            while Alive and Rend.On and Rend.Token == token do
                for g in pairs(Rend.Guis) do
                    if g.Parent and g.Enabled then g.Enabled = false end
                end
                for a in pairs(Rend.Anims) do
                    if a.Parent then
                        for _, tr in ipairs(a:GetPlayingAnimationTracks()) do
                            pcall(tr.Stop, tr, 0)
                        end
                    end
                end
                task.wait(2)
            end
        end)
    else
        for _, c in ipairs(Rend.Conns) do pcall(function() c:Disconnect() end) end
        Rend.Conns = {}
        rendTech(false)
        rendRestore()
        if FX.On and S.FpsBoost then
            for inst, o in pairs(FX.Orig) do
                if inst and inst.Parent then
                    if inst:IsA("Decal") and o.Transparency ~= nil then
                        pcall(function() inst.Transparency = o.Transparency end)
                    elseif inst:IsA("BasePart") and o.Material == Enum.Material.Neon then
                        pcall(function() inst.Material = o.Material end)
                    end
                end
            end
        end
        fxRefresh()
    end
end

