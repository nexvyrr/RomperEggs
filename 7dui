local function groundPos(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { getChar() }
    local res = Workspace:Raycast(pos + Vector3.new(0, 300, 0), Vector3.new(0, -700, 0), params)
    if res then
        return Vector3.new(pos.X, res.Position.Y + 3.5, pos.Z)
    end
    return pos
end

local function dodge()
    if not S.Esquivar or carryingNow() then return false end
    local g = guardThreat()
    if not g then return false end
    local hrp = getHRP()
    if not hrp then return false end
    local gp = g:GetPivot().Position
    local away = Vector3.new(hrp.Position.X - gp.X, 0, hrp.Position.Z - gp.Z)
    if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
    away = away.Unit
    S.Estado = "Esquivando guardian..."
    local target = groundPos(hrp.Position + away * 120)
    moveTo(CFrame.new(target), abortFarm)
    local t0 = os.clock()
    while Alive and S.Run and os.clock() - t0 < 6 do
        if not guardThreat() then break end
        task.wait(0.2)
    end
    return true
end

local function pickaxeInHand()
    local c = getChar()
    local t = c and c:FindFirstChild("Pickaxe")
    return t ~= nil and t:IsA("Tool")
end

local function equipPickaxe()
    if pickaxeInHand() then return true end
    local hum = getHum()
    local bp = LP:FindFirstChildOfClass("Backpack")
    local tool = bp and bp:FindFirstChild("Pickaxe")
    if hum and tool and tool:IsA("Tool") then
        pcall(function() hum:EquipTool(tool) end)
        local t0 = os.clock()
        while os.clock() - t0 < 1 and not pickaxeInHand() do
            task.wait(0.05)
        end
    end
    return pickaxeInHand()
end

local function swingAt(egg)
    local req = RS:FindFirstChild("EggHitRequest")
    if not req then return end
    local swing = RS:FindFirstChild("MasteryPickaxeSwing")
    if swing then swing:FireServer() end
    task.delay(CFG.RetrasoGolpe, function()
        if not Alive or not S.Run then return end
        if not eggLive(egg) or not pickaxeInHand() then return end
        S.HitId = S.HitId + 1
        req:FireServer(egg, S.HitId)
    end)
end

local function breakEgg(egg)
    local last = 0
    local winHp = tonumber(egg:GetAttribute("Health")) or 0
    local winT = os.clock()
    local lastCheck = os.clock()
    local startT = os.clock()
    local lastHp = tonumber(egg:GetAttribute("Health"))
    local lastDrop = os.clock()
    local lastFix = os.clock()
    local fixN = 0

    while Alive and S.Run and not isDead() do
        if dodge() then return "switch" end
        if not egg.Parent then return "gone" end
        if not eggLive(egg) then return "dead" end
        local hp = egg:GetAttribute("Health")
        if type(hp) == "number" and hp <= 0 then return "dead" end
        if S.Selected and S.Selected ~= egg and eggLive(S.Selected) then return "switch" end

        local now = os.clock()

        if type(hp) == "number" and (lastHp == nil or hp < lastHp) then
            lastHp, lastDrop = hp, now
        end
        local limDano = S.Evento and 90 or CFG.SinDano
        local limTotal = S.Evento and 900 or CFG.MaxPorHuevo
        if now - lastDrop > limDano or now - startT > limTotal then
            Black[egg] = now + CFG.VetoHuevo
            ST.Vetados = ST.Vetados + 1
            if S.Selected == egg then
                S.Selected = nil
                selectAuto()
            end
            notify("n_noprog", "triangle-alert")
            return "switch"
        end

        if type(hp) == "number" and now - winT >= 1.5 then
            if hp < winHp then
                local sample = (winHp - hp) / (now - winT)
                if S.Dps <= 0 then S.Dps = sample else S.Dps = S.Dps * 0.7 + sample * 0.3 end
            end
            winHp, winT = hp, now
        end

        if eggZone(egg) > allowedMaxZone() then return "switch" end

        local hrp = getHRP()
        if hrp and surfDist(egg, hrp.Position) > 6.5 then
            if not moveTo(standCF(egg), abortFarm) then return "gone" end
            lastDrop = os.clock()
            lastFix = lastDrop
        elseif now - lastDrop > 5 and now - lastFix > 5 then
            lastFix = now
            fixN = fixN + 1
            S.Estado = "Reposicionando..."
            if not moveTo(standCF(egg, math.rad(65 * fixN)), abortFarm) then return "gone" end
        end
        if not pickaxeInHand() then equipPickaxe() end

        if now - last >= S.Cooldown then
            last = now
            swingAt(egg)
        end
        task.wait()
    end
    return "gone"
end

local function carrying()
    return carryingNow()
end

local function findPickup(hatchId, pos, allowUnhatched)
    local best, bestD
    for _, m in ipairs(CollectionService:GetTagged("AnimalPickup")) do
        if m:IsA("Model") and m.Parent and not m:GetAttribute("Despawning") then
            local hatched = m:GetAttribute("Hatched") and true or false
            if hatched or allowUnhatched then
                local hid = m:GetAttribute("HatchId")
                if hatchId ~= nil and hid ~= nil then
                    if hid == hatchId then return m end
                elseif pos then
                    local d = m:GetPivot().Position - pos
                    d = Vector3.new(d.X, 0, d.Z).Magnitude
                    if d < 150 and (not bestD or d < bestD) then
                        best, bestD = m, d
                    end
                end
            end
        end
    end
    return best
end

local function findStealPrompt(pickup)
    for _, d in ipairs(pickup:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Name == "StealPrompt" then return d end
    end
    local pivot = pickup:GetPivot().Position
    local best, bestD
    local function consider(p)
        if p:IsA("ProximityPrompt") and p.Name == "StealPrompt" then
            local par = p.Parent
            if par and par:IsA("BasePart") then
                local d = (par.Position - pivot).Magnitude
                if not bestD or d < bestD then best, bestD = p, d end
            end
        end
    end
    for _, p in ipairs(CollectionService:GetTagged("SmartPrompt")) do
        consider(p)
    end
    if not best then
        for _, a in ipairs(Workspace:GetChildren()) do
            if a.Name == "PromptAnchor" then
                for _, p in ipairs(a:GetChildren()) do consider(p) end
            end
        end
    end
    if best and bestD < 80 then return best end
    for _, d in ipairs(pickup:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    return nil
end

local function holdPrompt(prompt)
    local hold = tonumber(prompt.HoldDuration) or 0
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(hold + 0.12)
    pcall(function() prompt:InputHoldEnd() end)
end

local function pressPromptKey(prompt)
    if not VIM then return end
    local key = Enum.KeyCode.E
    pcall(function()
        if prompt and prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then key = prompt.KeyboardKeyCode end
    end)
    local hold = 0.5
    pcall(function() hold = (tonumber(prompt.HoldDuration) or 0) + 0.2 end)
    pcall(function()
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(hold)
        VIM:SendKeyEvent(false, key, false, game)
    end)
end

local function grab(pickup)
    local t0 = os.clock()
    local tries = 0
    while Alive and S.Run and not isDead() and os.clock() - t0 < CFG.EsperaGrab do
        if carrying() then return true end
        if not pickup.Parent then break end
        if not S.Carried and dodge() then t0 = os.clock() end

        local prompt = findStealPrompt(pickup)
        local pos = pickup:GetPivot().Position
        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
            pos = prompt.Parent.Position
        end

        local hrp = getHRP()
        if hrp and (hrp.Position - pos).Magnitude > 3 then
            moveTo(CFrame.new(pos + Vector3.new(0, 1.5, 0)), abortFarm)
        end

        if prompt then
            if prompt.Enabled then
                S.Estado = "Agarrando el animal..."
                tries = tries + 1
                if tries % 3 == 1 then
                    holdPrompt(prompt)
                elseif tries % 3 == 2 then
                    if fireproximityprompt then pcall(fireproximityprompt, prompt) end
                    task.wait(0.1)
                else
                    pressPromptKey(prompt)
                end
            else
                S.Estado = "Esperando que se active el prompt de robo..."
            end
        else
            S.Estado = "Buscando el prompt de robo..."
        end
        task.wait(0.25)
    end
    return carrying()
end

