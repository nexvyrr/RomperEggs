local function travelSpeed()
    local hum = getHum()
    local ws = (hum and hum.WalkSpeed) or 16
    return math.clamp(ws * S.VelMult, 12, 240)
end

local function clearSpot(cf)
    local pos = cf.Position
    local ok, res = pcall(function()
        local ignore = { getChar() }
        for _, tag in ipairs({ "BreakableEgg", "AnimalPickup", "BreakableHalloweenDoor", "BreakableCandyPile" }) do
            for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                ignore[#ignore + 1] = inst
            end
        end
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignore
        pcall(function() params.RespectCanCollide = true end)
        for i = 0, 10 do
            local test = pos + Vector3.new(0, i * 2.5, 0)
            local parts = Workspace:GetPartBoundsInBox(CFrame.new(test), Vector3.new(3, 5, 2.5), params)
            local blocked = false
            for _, p in ipairs(parts) do
                if p.CanCollide then blocked = true break end
            end
            if not blocked then
                return CFrame.new(test) * cf.Rotation
            end
        end
        return cf
    end)
    if ok and res then return res end
    return cf
end

local function calm(h)
    h.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    h.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end
local Move = { N = 0, T = 0, CC = setmetatable({}, { __mode = "k" }) }
local SOLID = { HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true }

function Move.noclip(char)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if Move.CC[p] == nil then Move.CC[p] = p.CanCollide end
            if p.CanCollide then p.CanCollide = false end
        end
    end
end

function Move.enforce()
    for p in pairs(Move.CC) do
        if p.Parent and p.CanCollide then p.CanCollide = false end
    end
end

function Move.release(force)
    for p, v in pairs(Move.CC) do
        if p.Parent then pcall(function() p.CanCollide = v end) end
        Move.CC[p] = nil
    end
    local c = getChar()
    if c then
        for name in pairs(SOLID) do
            local p = c:FindFirstChild(name)
            if p and p:IsA("BasePart") and not p.CanCollide then
                pcall(function() p.CanCollide = true end)
            end
        end
    end
    local hum, hrp = getHum(), getHRP()
    if hum and hum.Health > 0 then
        if force or not (c and c:GetAttribute("Ragdolled")) then
            pcall(function() hum.PlatformStand = false end)
        end
    end
    if hrp then calm(hrp) end
end

function Move.reset()
    S.Gen = S.Gen + 1
    task.defer(function()
        task.wait(0.15)
        if Alive and Move.N == 0 then pcall(Move.release, true) end
    end)
end

local function moveTo(cf, abort, speed)
    local hrp = getHRP()
    local char = getChar()
    if not hrp or not char then return false end
    speed = speed or travelSpeed()

    local startPos = hrp.Position
    local goal = cf.Position
    local dist = (goal - startPos).Magnitude
    if dist <= 4 then
        hrp.CFrame = clearSpot(cf)
        calm(hrp)
        return true
    end

    local gen = S.Gen
    local hum = getHum()
    Move.N = Move.N + 1
    Move.T = os.clock()
    if hum then pcall(function() hum.PlatformStand = true end) end
    Move.noclip(char)

    local dir = (goal - startPos).Unit
    local rot = cf.Rotation
    local traveled = 0
    local ok = true

    local okRun = pcall(function()
        while traveled < dist do
            if not Alive or S.Gen ~= gen or (abort and abort()) then ok = false break end
            local h = getHRP()
            if not h then ok = false break end
            local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
            Move.T = os.clock()
            local left = dist - traveled
            local step = speed * dt
            if left < speed * 0.25 then
                step = math.max(step * (left / (speed * 0.25)), 0.4)
            end
            traveled = math.min(traveled + step, dist)
            local pos = startPos:Lerp(goal, traveled / dist)
            Move.enforce()
            h.CFrame = CFrame.new(pos) * rot
            h.AssemblyLinearVelocity = dir * speed
            h.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end)
    if not okRun then ok = false end

    local h = getHRP()
    if h then
        local final = ok and cf or h.CFrame
        h.CFrame = clearSpot(final)
        calm(h)
    end
    Move.N = math.max(Move.N - 1, 0)
    if Move.N == 0 then pcall(Move.release, true) end
    for _ = 1, 3 do
        RunService.Heartbeat:Wait()
        local h2 = getHRP()
        if h2 then calm(h2) end
    end
    if Move.N == 0 then
        local hm = getHum()
        if hm then pcall(function() hm.PlatformStand = false end) end
    end
    return ok
end

