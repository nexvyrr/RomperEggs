    end
    if S.Selected and not selLabel and eggLive(S.Selected) then
        local base = eggLabel(eggInfo(S.Selected, nil), 0)
        local lb = "* " .. string.gsub(base, "^0%. ", "")
        table.insert(values, 2, lb)
        map[lb] = S.Selected
        sig[#sig + 1] = lb
        selLabel = lb
    end
    EggByLabel = map

    local key = table.concat(sig, "|") .. "#" .. tostring(selLabel)
    if key ~= lastSig and EggDropdown then
        lastSig = key
        pcall(function() EggDropdown:Refresh(values) end)
        pcall(function() EggDropdown:Select(selLabel or AUTO_LABEL) end)
    end

