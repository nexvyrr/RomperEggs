    if not base then return nil end
    local hb = base:FindFirstChild("Hitbox")
    if hb and hb:IsA("BasePart") then
        return CFrame.new(hb.Position.X, hb.Position.Y - hb.Size.Y / 2 + 3.5, hb.Position.Z)
    end
    local sp = base:FindFirstChild("SpawnPoint")
    if sp and sp:IsA("BasePart") then
        return CFrame.new(sp.Position + Vector3.new(0, 3, 0))
    end
    return nil
