local function desiredEgg()
    local sel = S.Selected
    if sel then
        if eggLive(sel) and eggZone(sel) <= allowedMaxZone() then return sel end
        S.Selected = nil
        selectAuto()
    end
    local list = scanEggs()
    if #list == 0 then return nil end
    local top = list[1]

    local cur = S.Target
    if cur and cur ~= top.part and eggLive(cur) then
        for _, info in ipairs(list) do
            if info.part == cur then
                if info.value >= top.value * 0.9 then return cur end
                break
            end
        end
    end
    return top.part
end

local function surfDist(p, pos)
    if p:GetAttribute("TargetShape") == "Box" then
        local l = p.CFrame:PointToObjectSpace(pos)
        local h = p.Size * 0.5
        return Vector3.new(
            math.max(math.abs(l.X) - h.X, 0),
            math.max(math.abs(l.Y) - h.Y, 0),
            math.max(math.abs(l.Z) - h.Z, 0)
        ).Magnitude
    end
    local sz = p.Size
    local d = pos - p.Position
    local flat = math.max(Vector3.new(d.X, 0, d.Z).Magnitude - math.max(sz.X, sz.Z) / 2, 0)
    local vert = math.max(math.abs(d.Y) - sz.Y / 2, 0)
    return math.sqrt(flat * flat + vert * vert)
end

local function floorAt(x, y, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = { getChar() }
    for _, tag in ipairs({ "BreakableEgg", "AnimalPickup", "BreakableHalloweenDoor", "BreakableCandyPile" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            list[#list + 1] = inst
        end
    end
    params.FilterDescendantsInstances = list
    pcall(function() params.RespectCanCollide = true end)
    local res = Workspace:Raycast(Vector3.new(x, y, z), Vector3.new(0, -90, 0), params)
    if res then return res.Position.Y end
    return nil
end

local function standCF(egg, ang)
    local hrp = getHRP()
    local sz = egg.Size
    local r = math.max(sz.X, sz.Z) / 2 + 3
    local dir = Vector3.new(1, 0, 0)
    if hrp then
        local d = hrp.Position - egg.Position
        d = Vector3.new(d.X, 0, d.Z)
        if d.Magnitude > 0.5 then dir = d.Unit end
    end
    if ang and ang ~= 0 then
        dir = (CFrame.Angles(0, ang, 0) * dir)
    end
    local pos = egg.Position + dir * r
    local y = egg.Position.Y - sz.Y / 2 + 3.2
    local fy = floorAt(pos.X, egg.Position.Y + 4, pos.Z)
    if fy and math.abs((fy + 3.2) - y) < 25 then
        y = fy + 3.2
    end
    return CFrame.new(Vector3.new(pos.X, y, pos.Z), Vector3.new(egg.Position.X, y, egg.Position.Z))
end

