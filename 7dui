local function findPickup(hatchId, pos, allowUnhatched)
    local best, bestD
    for _, m in ipairs(CollectionService:GetTagged("AnimalPickup")) do
        if m:IsA("Model") and m.Parent and not m:GetAttribute("Despawning") then
            local hatched = m:GetAttribute("Hatched") and true or false
            if hatched or allowUnhatched then
                local hid = m:GetAttribute("HatchId")
                if hatchId ~= nil and hid ~= nil then
                    if hid == hatchId then return m end
                elseif pos then
                    local d = m:GetPivot().Position - pos
                    d = Vector3.new(d.X, 0, d.Z).Magnitude
                    if d < 150 and (not bestD or d < bestD) then
                        best, bestD = m, d
                    end
                end
            end
        end
    end
    return best
end

local function findStealPrompt(pickup)
    for _, d in ipairs(pickup:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Name == "StealPrompt" then return d end
    end
    local pivot = pickup:GetPivot().Position
    local best, bestD
    local function consider(p)
        if p:IsA("ProximityPrompt") and p.Name == "StealPrompt" then
            local par = p.Parent
            if par and par:IsA("BasePart") then
                local d = (par.Position - pivot).Magnitude
                if not bestD or d < bestD then best, bestD = p, d end
            end
        end
    end
    for _, p in ipairs(CollectionService:GetTagged("SmartPrompt")) do
        consider(p)
    end
    if not best then
        for _, a in ipairs(Workspace:GetChildren()) do
            if a.Name == "PromptAnchor" then
                for _, p in ipairs(a:GetChildren()) do consider(p) end
            end
        end
    end
    if best and bestD < 80 then return best end
    for _, d in ipairs(pickup:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    return nil
end

local function holdPrompt(prompt)
    local hold = tonumber(prompt.HoldDuration) or 0
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(hold + 0.12)
    pcall(function() prompt:InputHoldEnd() end)
end

local function pressPromptKey(prompt)
    if not VIM then return end
    local key = Enum.KeyCode.E
    pcall(function()
        if prompt and prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then key = prompt.KeyboardKeyCode end
    end)
    local hold = 0.5
    pcall(function() hold = (tonumber(prompt.HoldDuration) or 0) + 0.2 end)
    pcall(function()
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(hold)
        VIM:SendKeyEvent(false, key, false, game)
    end)
end

local function grab(pickup)
    local t0 = os.clock()
    local tries = 0
    while Alive and S.Farm and not isDead() and os.clock() - t0 < CFG.EsperaGrab do
        if carrying() then return true end
        if not pickup.Parent then break end
        if not S.Carried and dodge() then t0 = os.clock() end

        local prompt = findStealPrompt(pickup)
        local pos = pickup:GetPivot().Position
        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
            pos = prompt.Parent.Position
        end

        local hrp = getHRP()
        if hrp and (hrp.Position - pos).Magnitude > 3 then
            moveTo(CFrame.new(pos + Vector3.new(0, 1.5, 0)), abortFarm)
        end

        if prompt then
            if prompt.Enabled then
                S.Estado = "Agarrando el animal..."
                tries = tries + 1
                if tries % 3 == 1 then
                    holdPrompt(prompt)
                elseif tries % 3 == 2 then
                    if fireproximityprompt then pcall(fireproximityprompt, prompt) end
                    task.wait(0.1)
                else
                    pressPromptKey(prompt)
                end
            else
                S.Estado = "Esperando que se active el prompt de robo..."
            end
        else
            S.Estado = "Buscando el prompt de robo..."
        end
        task.wait(0.25)
    end
    return carrying()
end

