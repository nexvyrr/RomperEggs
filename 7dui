local FX = {
    On        = false,
    Token     = 0,
    Restoring = false,
    Orig      = setmetatable({}, { __mode = "k" }),
    Conns     = {},
    Light     = nil,
    Terrain   = nil,
    Quality   = nil,
}

local FX_KIND = {
    ParticleEmitter     = "emitter",
    Trail               = "enabled",
    Beam                = "enabled",
    Fire                = "enabled",
    Smoke               = "enabled",
    Sparkles            = "enabled",
    PointLight          = "enabled",
    SpotLight           = "enabled",
    SurfaceLight        = "enabled",
    Highlight           = "enabled",
    Clouds              = "enabled",
    BloomEffect         = "enabled",
    BlurEffect          = "enabled",
    ColorCorrectionEffect = "enabled",
    DepthOfFieldEffect  = "enabled",
    SunRaysEffect       = "enabled",
    Atmosphere          = "atmos",
    Explosion           = "explosion",
    Texture             = "texture",
}

local FX_TAGS = { "VFX", "EnabledVFX", "ParticleEmitter" }

local function fxApply(inst)
    if inst.Name == "NEXVYRHUB_ESP" then return end
    local kind = FX_KIND[inst.ClassName]
    local o = FX.Orig[inst]

    if kind == "emitter" then
        if not o then
            FX.Orig[inst] = { Enabled = inst.Enabled, Rate = inst.Rate, Lifetime = inst.Lifetime }
        end
        if inst.Enabled then inst.Enabled = false end
        if inst.Rate ~= 0 then inst.Rate = 0 end
        inst.Lifetime = NumberRange.new(0)
    elseif kind == "enabled" then
        if not o then FX.Orig[inst] = { Enabled = inst.Enabled } end
        if inst.Enabled then inst.Enabled = false end
    elseif kind == "atmos" then
        if not o then FX.Orig[inst] = { Density = inst.Density, Haze = inst.Haze, Glare = inst.Glare } end
        inst.Density = 0
        inst.Haze = 0
        inst.Glare = 0
    elseif kind == "explosion" then
        if not o then FX.Orig[inst] = { Visible = inst.Visible } end
        inst.Visible = false
    elseif kind == "texture" then
        if not o then FX.Orig[inst] = { Transparency = inst.Transparency } end
        if inst.Transparency < 1 then inst.Transparency = 1 end
    elseif inst:IsA("BasePart") and not inst:IsA("Terrain") then
        local changed = false
        if not o then
            o = { Material = inst.Material, CastShadow = inst.CastShadow, Reflectance = inst.Reflectance }
            if inst:IsA("MeshPart") then o.RenderFidelity = inst.RenderFidelity end
            changed = true
        end
        if changed then FX.Orig[inst] = o end
        if inst.Material ~= Enum.Material.Neon and inst.Material ~= Enum.Material.Plastic then
            inst.Material = Enum.Material.Plastic
        end
        if inst.CastShadow then inst.CastShadow = false end
        if inst.Reflectance ~= 0 then inst.Reflectance = 0 end
        if inst:IsA("MeshPart") and inst.RenderFidelity ~= Enum.RenderFidelity.Performance then
            inst.RenderFidelity = Enum.RenderFidelity.Performance
        end
    end
end

local function fxHook(inst)
    if not FX.On then return end
    pcall(fxApply, inst)
end

local function fxSweep(token)
    local t = os.clock()
    for _, root in ipairs({ Lighting, Workspace }) do
        local list = root:GetDescendants()
        for i = 1, #list do
            if FX.Token ~= token or not FX.On or not Alive then return end
            pcall(fxApply, list[i])
            if os.clock() - t > 0.004 then
                task.wait()
                t = os.clock()
            end
        end
    end
end

local function fxEnvironment(on)
    if on then
        if not FX.Light then
            FX.Light = {}
            for _, p in ipairs({ "GlobalShadows", "ShadowSoftness", "EnvironmentSpecularScale" }) do
                pcall(function() FX.Light[p] = Lighting[p] end)
            end
        end
        pcall(function() Lighting.GlobalShadows = false end)
        pcall(function() Lighting.ShadowSoftness = 0 end)
        pcall(function() Lighting.EnvironmentSpecularScale = 0 end)

        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            if not FX.Terrain then
                FX.Terrain = {}
                for _, p in ipairs({ "WaterWaveSize", "WaterWaveSpeed", "WaterReflectance" }) do
                    pcall(function() FX.Terrain[p] = terrain[p] end)
                end
            end
            pcall(function() terrain.WaterWaveSize = 0 end)
            pcall(function() terrain.WaterWaveSpeed = 0 end)
            pcall(function() terrain.WaterReflectance = 0 end)
            if sethiddenproperty then
                pcall(sethiddenproperty, terrain, "Decoration", false)
            end
        end

        pcall(function()
            local r = settings().Rendering
            if FX.Quality == nil then FX.Quality = r.QualityLevel end
            r.QualityLevel = Enum.QualityLevel.Level01
        end)
    else
        if FX.Light then
            for p, v in pairs(FX.Light) do
                pcall(function() Lighting[p] = v end)
            end
            FX.Light = nil
        end
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain and FX.Terrain then
            for p, v in pairs(FX.Terrain) do
                pcall(function() terrain[p] = v end)
            end
            if sethiddenproperty then
                pcall(sethiddenproperty, terrain, "Decoration", true)
            end
        end
        FX.Terrain = nil
        if FX.Quality ~= nil then
            pcall(function() settings().Rendering.QualityLevel = FX.Quality end)
            FX.Quality = nil
        end
    end
end

local function fxRestoreAll()
    FX.Restoring = true
    local snapshot = {}
    for inst, o in pairs(FX.Orig) do
        snapshot[#snapshot + 1] = { inst, o }
    end
    FX.Orig = setmetatable({}, { __mode = "k" })

    local t = os.clock()
    for i = 1, #snapshot do
        local inst, o = snapshot[i][1], snapshot[i][2]
        if inst and inst.Parent then
            pcall(function()
                for prop, value in pairs(o) do
                    inst[prop] = value
                end
            end)
        end
        if os.clock() - t > 0.004 then
            task.wait()
            t = os.clock()
        end
    end
    FX.Restoring = false
end

local function fxSet(on)
    on = on and true or false
    if on == FX.On then return end
    FX.On = on
    FX.Token = FX.Token + 1
    local token = FX.Token

    if on then
        task.spawn(function()
            while FX.Restoring do task.wait(0.1) end
            if FX.Token ~= token or not FX.On then return end
            fxEnvironment(true)
            FX.Conns[#FX.Conns + 1] = Workspace.DescendantAdded:Connect(fxHook)
            FX.Conns[#FX.Conns + 1] = Lighting.DescendantAdded:Connect(fxHook)
            fxSweep(token)
        end)
    else
        for _, c in ipairs(FX.Conns) do pcall(function() c:Disconnect() end) end
        FX.Conns = {}
        fxEnvironment(false)
        task.spawn(fxRestoreAll)
    end
end

task.spawn(function()
    while Alive do
        if FX.On then
            for _, tag in ipairs(FX_TAGS) do
                for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                    pcall(fxApply, inst)
                end
            end
        end
        task.wait(2)
    end
end)

