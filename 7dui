local function eventTargets()
    local hrp = getHRP()
    local pos = hrp and hrp.Position
    local safe = safeMaxZone()
    local now = os.clock()
    local list = {}

    local function add(p, kind)
        if (Black[p] or 0) >= now then return end
        local z = eggZone(p)
        if z < 1 or z > safe then return end
        if guardActiveNear(p.Position, 80) then return end
        if kind == "door" or kind == "pile" then
            local hp = tonumber(p:GetAttribute("Health")) or 0
            if S.Dps > 0 and hp / S.Dps > 150 then return end
        end
        list[#list + 1] = {
            part = p,
            kind = kind,
            prio = EV_PRIO[kind],
            dist = pos and (p.Position - pos).Magnitude or 0,
        }
    end

    for _, p in ipairs(CollectionService:GetTagged("BreakableEgg")) do
        if p:IsA("BasePart") and eggLive(p) then
            if p:GetAttribute("Titanic") == true then
                add(p, "titanic")
            elseif CollectionService:HasTag(p, "LuckyEgg") or p:GetAttribute("Lucky") == true then
                add(p, "lucky")
            elseif phantomValid(p) then
                add(p, "phantom")
            end
        end
    end
    for _, p in ipairs(CollectionService:GetTagged("BreakableHalloweenDoor")) do
        if p:IsA("BasePart") and eggLive(p) then add(p, "door") end
    end
    for _, p in ipairs(CollectionService:GetTagged("BreakableCandyPile")) do
        if p:IsA("BasePart") and eggLive(p) then add(p, "pile") end
    end

    table.sort(list, function(a, b)
        if a.prio ~= b.prio then return a.prio < b.prio end
        return a.dist < b.dist
    end)
    return list
end

