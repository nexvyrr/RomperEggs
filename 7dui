            if S.StreamZonas and (S.Run or S.IrHuevo) and not isDead() and os.clock() >= blockedUntil then
                local ok = pcall(function()
                    readZones()
                    local cap = allowedMaxZone()
                    if cap < 1 then return end
                    step = step + 1
                    local z = cap
                    if cap > 1 and step % 2 == 0 then
                        z = (math.floor(step / 2) % (cap - 1)) + 1
                    end
                    local pos = zonePos[z]
                    if pos then LP:RequestStreamAroundAsync(pos, 3) end
                end)
                if ok then
                    fails = 0
                else
                    fails = fails + 1
                    if fails >= 3 then
                        fails = 0
                        blockedUntil = os.clock() + 60
                    end
                end
            end
            task.wait(CFG.StreamCada)
        end
    end)
