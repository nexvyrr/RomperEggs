local function farmCycle()
    if isDead() or not getHRP() then
        S.Estado = "Esperando personaje"
        task.wait(0.5)
        return
    end

    local c = getChar()
    if LP:GetAttribute("Jailed") == true then
        S.Estado = "Encarcelado, esperando"
        task.wait(0.5)
        return
    end
    if c and c:GetAttribute("Ragdolled") and not S.AntiGolpe then
        task.wait(0.3)
        return
    end

    if holding() then
        S.Estado = "Golpeado: quedandome en el lugar..."
        task.wait(0.1)
        return
    end

    if inForbiddenZone() and not S.Carried then
        escapeToBase()
        return
    end

    if carrying() then
        S.Busy = true
        Sub.go()
        S.Busy = false
        return
    end

    if S.Carried then
        S.Busy = true
        S.Estado = "Recuperando el animal..."
        local pickup
        local t0 = os.clock()
        while Alive and S.Farm and not isDead() and not holding() and os.clock() - t0 < 6 do
            local h = getHRP()
            pickup = h and findPickup(nil, h.Position, true)
            if pickup then break end
            task.wait(0.15)
        end
        if pickup then
            if grab(pickup) then
                S.RecTry = 0
                Sub.go()
            else
                S.RecTry = S.RecTry + 1
                if S.RecTry >= 4 then S.Carried = false; S.RecTry = 0 end
            end
        elseif not holding() then
            S.Carried = false
            S.RecTry = 0
        end
        S.Busy = false
        return
    end

    if dodge() then return end

    local egg = desiredEgg()
    if not egg then
        S.Estado = "No hay huevos en zonas seguras"
        task.wait(0.6)
        return
    end
    if not equipPickaxe() then
        notify("No tienes el pico", "triangle-alert")
        S.Estado = "No tienes el pico"
        task.wait(1)
        return
    end

    setHighlight(egg)
    S.Estado = "Yendo al huevo..."
    if not moveTo(standCF(egg), abortFarm) then return end

    S.Estado = "Rompiendo huevo..."
    local result = breakEgg(egg)
    if result == "switch" or not S.Farm then return end

    local t0 = os.clock()
    while Alive and S.Farm and os.clock() - t0 < 3 do
        if egg:GetAttribute("Hatching") or egg:GetAttribute("HatchId") ~= nil or not egg.Parent then break end
        task.wait(0.05)
    end
    local hatchId = egg:GetAttribute("HatchId")
    local epos = egg.Position
    if egg:GetAttribute("NoPickup") then return end

    S.Busy = true
    S.Estado = "Esperando que salga el animal..."
    local pickup
    t0 = os.clock()
    while Alive and S.Farm and not isDead() and os.clock() - t0 < CFG.EsperaPickup do
        pickup = findPickup(hatchId, epos, os.clock() - t0 > 10)
        if pickup then break end
        dodge()
        task.wait(0.1)
    end

    if not pickup then
        S.Estado = "No aparecio el animal (se salta este huevo)"
        S.Busy = false
        return
    end

    if grab(pickup) then
        S.Carried = true
        S.RecTry = 0
        Sub.go()
    else
        ST.Fallos = ST.Fallos + 1
        S.Estado = "No pude agarrar el animal"
        notify("No pude agarrar el animal", "triangle-alert")
    end
    S.Busy = false
end

