local SUF = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc" }
local function fmt(n)
    n = tonumber(n) or 0
    local i = 1
    while math.abs(n) >= 1000 and i < #SUF do
        n = n / 1000
        i = i + 1
    end
    local s = string.format("%.1f", n)
    s = s:gsub("%.0$", "")
    return s .. SUF[i]
end

