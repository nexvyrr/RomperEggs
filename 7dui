local function groundPos(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { getChar() }
    local res = Workspace:Raycast(pos + Vector3.new(0, 300, 0), Vector3.new(0, -700, 0), params)
    if res then
        return Vector3.new(pos.X, res.Position.Y + 3.5, pos.Z)
    end
    return pos
end

local function dodge()
    if not S.Esquivar or carryingNow() then return false end
    local g = guardThreat()
    if not g then return false end
    local hrp = getHRP()
    if not hrp then return false end
    local gp = g:GetPivot().Position
    local away = Vector3.new(hrp.Position.X - gp.X, 0, hrp.Position.Z - gp.Z)
    if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
    away = away.Unit
    S.Estado = "Esquivando guardian..."
    local target = groundPos(hrp.Position + away * 120)
    moveTo(CFrame.new(target), abortFarm)
    local t0 = os.clock()
    while Alive and S.Farm and os.clock() - t0 < 6 do
        if not guardThreat() then break end
        task.wait(0.2)
    end
    return true
end

