local function desiredEgg()
    local sel = S.Selected
    if sel then
        if eggLive(sel) and eggZone(sel) <= allowedMaxZone() then return sel end
        S.Selected = nil
        selectAuto()
    end
    local list = scanEggs()
    if #list == 0 then return nil end
    if S.Dps <= 0 then return list[1].part end

    local fastest = list[1]
    for _, info in ipairs(list) do
        if info.eta <= S.MaxEta then return info.part end
        if info.eta < fastest.eta then fastest = info end
    end
    return fastest.part
end

local function surfDist(p, pos)
    local sz = p.Size
    local d = pos - p.Position
    local flat = math.max(Vector3.new(d.X, 0, d.Z).Magnitude - math.max(sz.X, sz.Z) / 2, 0)
    local vert = math.max(math.abs(d.Y) - sz.Y / 2, 0)
    return math.sqrt(flat * flat + vert * vert)
end

local function standCF(egg)
    local hrp = getHRP()
    local sz = egg.Size
    local r = math.max(sz.X, sz.Z) / 2 + 3
    local dir = Vector3.new(1, 0, 0)
    if hrp then
        local d = hrp.Position - egg.Position
        d = Vector3.new(d.X, 0, d.Z)
        if d.Magnitude > 0.5 then dir = d.Unit end
    end
    local pos = egg.Position + dir * r
    local y = egg.Position.Y - sz.Y / 2 + 3.2
    return CFrame.new(Vector3.new(pos.X, y, pos.Z), Vector3.new(egg.Position.X, y, egg.Position.Z))
end

