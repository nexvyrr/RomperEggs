do
    local ZERO = Vector3.new(0, 0, 0)

    local function makeParams()
        local list = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character then list[#list + 1] = pl.Character end
        end
        for _, tag in ipairs({ "BreakableEgg", "AnimalPickup" }) do
            for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                list[#list + 1] = inst
            end
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = list
        pcall(function() params.RespectCanCollide = true end)
        return params
    end

    local function floorY(params, x, refY, z)
        local res = Workspace:Raycast(Vector3.new(x, refY, z), Vector3.new(0, -400, 0), params)
        if res then return res.Position.Y end
        return nil
    end

    local function noclip(char, saved)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if saved[p] == nil then saved[p] = p.CanCollide end
                if p.CanCollide then p.CanCollide = false end
            end
        end
    end

    function Sub.under(cf, abort)
        local char, hrp = getChar(), getHRP()
        if not char or not hrp then return false end

        local depth = CFG.Profundo
        local rot = hrp.CFrame.Rotation
        local p0 = hrp.Position
        local params = makeParams()
        local lastFy = floorY(params, p0.X, p0.Y + 4, p0.Z) or (p0.Y - 3)
        local saved = {}
        noclip(char, saved)

        local ok, arrived = true, false
        local x, z, curY = p0.X, p0.Z, p0.Y
        local scanAt = os.clock() + 0.3

        local function enforce()
            for p in pairs(saved) do
                if p.Parent and p.CanCollide then p.CanCollide = false end
            end
        end
        local function frame()
            local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
            if os.clock() >= scanAt then
                scanAt = os.clock() + 0.3
                local c = getChar()
                if c then noclip(c, saved) end
            end
            return dt
        end
        local function put(h, px, py, pz, vel)
            h.CFrame = CFrame.new(px, py, pz) * rot
            h.AssemblyLinearVelocity = vel
            h.AssemblyAngularVelocity = ZERO
        end

        S.Estado = "Farm 2: bajando bajo tierra..."
        local downY = lastFy - depth
        while ok and curY > downY + 0.05 do
            if not Alive or (abort and abort()) then ok = false break end
            local h = getHRP()
            if not h then ok = false break end
            local dt = frame()
            curY = math.max(curY - CFG.VelBajar * dt, downY)
            enforce()
            put(h, x, curY, z, ZERO)
        end

        local goal = cf.Position
        local fx, fz = goal.X - x, goal.Z - z
        local dist = math.sqrt(fx * fx + fz * fz)
        if ok and dist > 0.5 then
            local dx, dz = fx / dist, fz / dist
            local sx, sz = x, z
            local speed = travelSpeed()
            local vel = Vector3.new(dx * speed, 0, dz * speed)
            local traveled = 0
            S.Estado = "Farm 2: viajando bajo tierra a tu base..."
            while traveled < dist do
                if not Alive or (abort and abort()) then ok = false break end
                if not carryingNow() then break end
                local h = getHRP()
                if not h then ok = false break end
                local dt = frame()
                traveled = math.min(traveled + speed * dt, dist)
                x, z = sx + dx * traveled, sz + dz * traveled
                local f = floorY(params, x, math.max(lastFy, curY) + 5, z)
                if f then lastFy = f end
                curY = curY + ((lastFy - depth) - curY) * math.min(1, dt * 14)
                enforce()
                put(h, x, curY, z, vel)
            end
            arrived = ok and traveled >= dist
        else
            arrived = ok
        end

        local upY
        if arrived then
            x, z = goal.X, goal.Z
            upY = goal.Y
        else
            upY = lastFy + 3.5
        end
        S.Estado = "Farm 2: subiendo a la zona segura..."
        while ok and curY < upY - 0.05 do
            if not Alive or (abort and abort()) then ok = false break end
            local h = getHRP()
            if not h then ok = false break end
            local dt = frame()
            curY = math.min(curY + CFG.VelBajar * dt, upY)
            enforce()
            put(h, x, curY, z, ZERO)
        end

        local h = getHRP()
        if h then
            if curY < upY - 0.05 then
                h.CFrame = CFrame.new(x, upY, z) * rot
            elseif ok and arrived then
                h.CFrame = cf
            end
            h.AssemblyLinearVelocity = ZERO
            h.AssemblyAngularVelocity = ZERO
        end
        for p, v in pairs(saved) do
            if p.Parent then p.CanCollide = v end
        end
        return ok, arrived
    end

    function Sub.deliverUnder()
        local cf = baseCF()
        if not cf then
            notify("No encontre tu base", "triangle-alert")
            S.Estado = "No encontre tu base"
            return false
        end
        if not carrying() then return true end
        local okU, arrivedU = Sub.under(cf, abortFarm)
        if not okU or not arrivedU then return false end

        S.Estado = "Farm 2: dejando el animal..."
        local t0 = os.clock()
        while Alive and S.Farm and carrying() and os.clock() - t0 < CFG.EsperaBanco do
            task.wait(0.1)
        end
        if not carrying() then return true end

        S.Estado = "Farm 2: no se deposito, reintentando en superficie..."
        return deliver()
    end

    function Sub.go()
        local n = tonumber(LP:GetAttribute("CarryCount")) or 1
        if n < 1 then n = 1 end
        local ok
        if S.Under then
            ok = Sub.deliverUnder()
        else
            ok = deliver()
        end
        if ok and not carrying() then
            ST.Entregas = ST.Entregas + n
            S.Carried = false
            S.RecTry = 0
        end
        return ok
    end
end

